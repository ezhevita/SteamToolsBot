<Project Sdk="Microsoft.NET.Sdk.Worker">

	<PropertyGroup>
		<AnalysisMode>AllEnabledByDefault</AnalysisMode>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<NoWarn>CA1812;CA2007</NoWarn>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="AngleSharp" Version="1.8.6" />
		<PackageReference Include="FluentValidation" Version="12.2.0" />
		<PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
		<PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.14" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
		<PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
		<PackageReference Include="Polly" Version="8.8.1" />
		<PackageReference Include="Polly.Caching.Distributed" Version="3.0.1"/>
		<PackageReference Include="StackExchange.Redis" Version="3.4.20" />
		<PackageReference Include="Telegram.Bot" Version="22.10.3.3" />
	</ItemGroup>

</Project>
